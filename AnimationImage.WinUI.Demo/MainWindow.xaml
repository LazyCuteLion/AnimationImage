<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="AnimationImage.WinUI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ani="using:AnimationImage"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:AnimationImage.WinUI.Demo"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="AnimationImage.WinUI.Demo"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  上区：动图宿主  -->
        <Grid Grid.RowSpan="2" Background="Green">

            <!--  宿主元素：AnimatableBitmap 的 Source 附加属性会把 Composition Visual 挂在这里  -->
            <Border x:Name="img"
                    ani:AnimatableBitmap.AutoStart="True"
                    ani:AnimatableBitmap.RepeatBehavior="Forever" />

            <Border Margin="10"
                    Padding="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#7D000000">
                <TextBlock Foreground="White" Text="{Binding ElementName=img, Path=(ani:AnimatableBitmap.Source).TPS, Mode=OneWay}" />
            </Border>

            <Border Margin="10"
                    Padding="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#7D000000">
                <TextBlock Foreground="White" Text="{Binding ElementName=img, Path=(ani:AnimatableBitmap.Source).Metadata, Mode=OneWay}" />
            </Border>
        </Grid>

        <!--  下区：控制条  -->
        <Grid Grid.Row="1" Background="#2D000000">
            <StackPanel Margin="20,10,20,60">
                <Grid MinWidth="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Slider Maximum="{Binding ElementName=img, Path=(ani:AnimatableBitmap.Source).Metadata.Duration, Mode=OneWay}"
                            Minimum="0"
                            Value="{Binding ElementName=img, Path=(ani:AnimatableBitmap.AnimationTime), Mode=TwoWay}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Text="{Binding ElementName=img, Path=(ani:AnimatableBitmap.AnimationTime), Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <Grid Padding="10" VerticalAlignment="Bottom">
                <ComboBox Width="120"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{x:Bind StretchValues}"
                          SelectedValue="{Binding ElementName=img, Path=(ani:AnimatableBitmap.Stretch), Mode=TwoWay}"
                          SelectedValuePath="Value" />

                <StackPanel HorizontalAlignment="Right"
                            DataContext="{Binding ElementName=img, Path=(ani:AnimatableBitmap.Source)}"
                            Orientation="Horizontal">
                    <CheckBox x:Name="cbUseGPU"
                              MinWidth="0"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="显卡加速"
                              IsChecked="True" />
                    <CheckBox x:Name="cbPreload"
                              MinWidth="0"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="预加载"
                              IsChecked="True" />
                    <Button Margin="10,0"
                            Click="Open_Click"
                            Content="Open" />
                    <Button Margin="10,0"
                            Command="{Binding BeginCommand, Mode=OneTime}"
                            Content="Play" />
                    <Button Margin="10,0"
                            Command="{Binding PauseCommand, Mode=OneTime}"
                            Content="Pause" />
                    <Button Margin="10,0"
                            Command="{Binding StopCommand, Mode=OneTime}"
                            Content="Stop" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
