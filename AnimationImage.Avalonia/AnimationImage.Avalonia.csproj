<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DefineConstants>AVALONIA</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\nuget.readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\AnimationImage.WPF\Share\*.cs">
      <Link>\Share\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\AnimationImage.WPF\Share\Gpu\*.cs">
      <Link>\Share\Gpu\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
 
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="SkiaSharp.Skottie" Version="3.119.2" />
    <PackageReference Include="Silk.NET.Direct3D12" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>AnimationImage.Avalonia</PackageId>
    <Version>2.1.0</Version>
    <Authors>LazySheeeep</Authors>
    <Description>
      基于 SkiaSharp 的 AvaloniaUI 极简动图播放方案。
      支持播放 Lottie、GIF、WebP 格式。
      更高的帧率、更佳的性能、更少的内存占用。
    </Description>
    <PackageTags>avalonia;skiasharp;lottie;gif;webp;animation</PackageTags>
    <RepositoryUrl>https://github.com/LazyCuteLion/AnimationImage</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>nuget.readme.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
